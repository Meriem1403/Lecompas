FROM node:20-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

ARG VITE_API_BASE=http://localhost:8000/make-server-cfb78916
ARG VITE_USE_BACKEND_API=true
ARG VITE_ALLOW_DEMO_LOGIN=false

ENV VITE_API_BASE=$VITE_API_BASE
ENV VITE_USE_BACKEND_API=$VITE_USE_BACKEND_API
ENV VITE_ALLOW_DEMO_LOGIN=$VITE_ALLOW_DEMO_LOGIN

RUN npm run build

FROM nginx:1.27-alpine

COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
