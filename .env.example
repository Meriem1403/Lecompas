# Copier vers .env et adapter pour le serveur intranet (ex. NAS 10.13.186.8)

PUBLIC_HOST=10.13.186.8

POSTGRES_DB=lecompas
POSTGRES_USER=lecompas
POSTGRES_PASSWORD=changez-moi-en-prod

FRONTEND_PORT=8080
BACKEND_PORT=8000

# URL vue par le navigateur des utilisateurs (pas localhost si accès depuis d'autres PC)
VITE_API_BASE=http://10.13.186.8:8000/make-server-cfb78916

# Origines autorisées pour CORS (séparer par des virgules)
CORS_ORIGINS=http://10.13.186.8:8080,http://lecompas.intranet

# false en prod intranet ; true seulement pour démo sans API
VITE_ALLOW_DEMO_LOGIN=false

# Prod intranet : laisser true (défaut du Dockerfile.prod)
VITE_USE_BACKEND_API=true

# Dossier des sauvegardes PostgreSQL (scripts/backup-postgres.sh)
# BACKUP_DIR=./backups/postgres
